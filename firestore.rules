rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.email == "adityaofficial9918@gmail.com"; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    
    // --- Validation Blueprints ---
    function isValidLead(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.email is string && data.email.size() > 5 && data.email.size() <= 255 &&
             data.company is string && data.company.size() > 0 && data.company.size() <= 200 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 50 &&
             data.projectType is string && data.projectType.size() > 0 && data.projectType.size() <= 100 &&
             data.urgency is string && data.urgency.size() > 0 && data.urgency.size() <= 100 &&
             data.budget is string && data.budget.size() > 0 && data.budget.size() <= 100 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 2000 &&
             data.status in ['new', 'contacted', 'qualified', 'closed'] &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
             data.createdAt == request.time;
    }

    function isValidProfile(data) {
      return (data.displayName is string && data.displayName.size() <= 100) &&
             (!('company' in data) || (data.company is string && data.company.size() <= 200)) &&
             (!('role' in data) || (data.role is string && data.role.size() <= 100)) &&
             (!('industry' in data) || (data.industry is string && data.industry.size() <= 100)) &&
             data.updatedAt == request.time;
    }

    // --- Collections ---
    match /leads/{leadId} {
      // 1. Creation: Anyone (authenticated or not) can submit a lead to your agency
      allow create: if isValidId(leadId) && 
                      isValidLead(incoming()) &&
                      incoming().keys().hasAll(['name', 'email', 'company', 'phone', 'projectType', 'urgency', 'budget', 'message', 'status', 'createdAt']) &&
                      incoming().keys().size() >= 10 &&
                      incoming().keys().size() <= 12;

      // 2. Reading: Admin can read all leads, or users can read their own submitted leads
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      // 3. Updating: Only YOU can update lead status
      allow update: if isAdmin() && 
                      incoming().createdAt == resource.data.createdAt;

      // 4. Deleting: Only YOU can delete junk leads
      allow delete: if isAdmin();
    }

    // Career Applications
    match /career_applications/{appId} {
      // Anyone can submit career applications
      allow create: if isValidId(appId) &&
                      incoming().fullName is string && incoming().fullName.size() > 0 && incoming().fullName.size() <= 200 &&
                      incoming().email is string && incoming().email.size() > 5 && incoming().email.size() <= 255 &&
                      incoming().phone is string && incoming().phone.size() > 0 && incoming().phone.size() <= 50;
      
      // Admin can view, update status, delete applications
      allow get, list, update, delete: if isAdmin();
    }

    // Razorpay Payments Audit Trail
    match /payments/{paymentId} {
      allow create: if isValidId(paymentId);
      allow get, list, update, delete: if isAdmin();
    }

    // Active Job Openings Management
    match /job_openings/{jobId} {
      allow read, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // User Profile Management
    match /profiles/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create, update: if isValidId(userId) && isSignedIn() && request.auth.uid == userId && isValidProfile(incoming());
    }

    // System Settings & Maintenance Configuration
    match /settings/{settingId} {
      allow read, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Identity Isolation for Users
    match /users/{userId} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }
  }
}


