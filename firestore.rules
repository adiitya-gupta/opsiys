rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Fallback Rule: Allow read/write for operational collections
    match /{document=**} {
      allow read, write: if true;
    }

    match /leads/{leadId} {
      allow read, write: if true;
    }

    match /career_applications/{appId} {
      allow read, write: if true;
    }

    match /payments/{paymentId} {
      allow read, write: if true;
    }

    match /job_openings/{jobId} {
      allow read, write: if true;
    }

    match /blog_posts/{blogId} {
      allow read, write: if true;
    }

    match /admin_users/{adminId} {
      allow read, write: if true;
    }

    match /profiles/{userId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /eod_reports/{reportId} {
      allow read, write: if true;
    }

    match /tasks/{taskId} {
      allow read, write: if true;
    }
  }
}
